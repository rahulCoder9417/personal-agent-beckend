# Copy to .env and fill in. Validated at startup (src/shared/config.ts). Never commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# The laptop: the compose `postgres` (start it with `--profile localdb`).
# The server: Neon, set as BACKEND_DATABASE_URL in compose.env (it wins over this line there), on
# the direct host (no `-pooler`) with ?sslmode=verify-full&channel_binding=require, e.g.
# postgresql://USER:PASSWORD@ep-NAME.REGION.aws.neon.tech/agent?sslmode=verify-full&channel_binding=require
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# Connections each process (api, worker) keeps open even when idle, and how often they are checked
# with a tiny query. A new connection to Neon costs 1.5 to 2.5 s; these keep a page from paying it.
DB_POOL_MIN=10
DB_PING_SECONDS=60
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=pa

PUBLIC_API_URL=http://localhost:8080
# How containers reach /mcp through the egress proxy
INTERNAL_API_URL=http://api:8080
WEB_APP_URL=http://localhost:3000

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Clerk
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# vm-manager (gRPC)
VM_MANAGER_URL=http://localhost:9090
# 32+ chars, same value as the vm-manager's
VM_INTERNAL_SECRET=dev-internal-secret-change-me-0123456789

# LiteLLM
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-dev-master-key
LITELLM_CHEAP_MODEL=cheap
LITELLM_PAID_MODELS=cheap,claude,gpt
# Containers call this model name; each user's key aliases it to cheap (Free) or premium (paid)
LITELLM_AGENT_MODEL=agent-default
LITELLM_PREMIUM_MODEL=claude
# Hermes's crew calls this name; each key aliases it to cheap (Free) or the crew model (paid)
LITELLM_CREW_MODEL=agent-crew
LITELLM_PREMIUM_CREW_MODEL=claude-crew
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STT_MODEL=whisper

# Channels that are switched on, comma-separated: telegram, web, whatsapp, imessage.
# Launch: Telegram and the web app. A channel that is off can't be linked, its webhook does no
# work and nothing is sent to it. Empty = telegram,web.
ENABLED_CHANNELS=telegram,web

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# "typing…" in the chat while the agent works on a message. Empty or true = on; false = off.
TELEGRAM_TYPING=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_TEMPLATE_REMINDER=reminder
WHATSAPP_TEMPLATE_APPROVAL=approval_needed
WHATSAPP_TEMPLATE_TASK_DONE=task_done
WHATSAPP_TEMPLATE_LANG=en

# Sendblue (iMessage)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_SIGNING_SECRET=
SENDBLUE_NUMBER=

# Composio
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# JSON map of app slug -> Composio auth config id (our own sign-in app for an app goes here)
COMPOSIO_AUTH_CONFIGS={}
# Apps the server may set up by itself at Composio, with Composio's shared sign-in, on the first
# connect: `all`, or app names such as googlecalendar,notion,slack. Empty: none. docs/composio.md, section 8
COMPOSIO_MANAGED_APPS=
# Trial: a second setup per app, only for the users named in COMPOSIO_TRIAL_USERS (our own Google
# sign-in app while Google reviews it). JSON like COMPOSIO_AUTH_CONFIGS, e.g. {"googlecalendar":"ac_..."}.
# Users: user ids (usr_...) or verified emails, separated by commas. docs/composio.md, section 9
COMPOSIO_TRIAL_AUTH_CONFIGS=
COMPOSIO_TRIAL_USERS=

# Jev routing (TypeSafe). Without JEV_API_KEY every message goes to the agent (no shortcut).
# JEV_URL defaults to https://api.typesafe.ai; LiteLLM's pass-through also works: http://litellm:4000/typesafe
JEV_URL=
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3000
# Start waking the container while Jev decides (a task then waits for one, not both). A message that
# turns out simple leaves the container idle until its idle stop. Empty or true = on; false = off.
WAKE_WHILE_ROUTING=
# Automations with steps run (up to 6 steps in one run). Off: they can be made and changed, but a
# run does nothing and says steps are switched off. Empty or true = on; false = off.
AUTOMATION_STEPS=

# Polar (payments). Sandbox and production are separate: each has its own organization access
# token, products, discount and webhook endpoint, so switching POLAR_SERVER means changing all of
# these lines together. Then run `pnpm polar:check` (read-only) before taking payments.
# Token scopes: checkouts:write, customer_sessions:write, subscriptions:write, orders:read,
# orders:write, customers:read, products:read, discounts:read, webhooks:read.
POLAR_ACCESS_TOKEN=
# The endpoint's whsec_... secret, pasted as-is. Endpoint: <PUBLIC_API_URL>/webhooks/polar,
# format Raw, API version 2026-10, the events listed by `pnpm polar:check`
POLAR_WEBHOOK_SECRET=
# sandbox (sandbox-api.polar.sh) or production (api.polar.sh)
POLAR_SERVER=sandbox
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_MAX=
POLAR_PRODUCT_TOPUP_10=
# Waitlist offer: a Polar discount id for 50% off the first month of Pro/Max (duration: once)
POLAR_WAITLIST_DISCOUNT_ID=
# Auto top-up (Pro and Max): Polar charges the saved card for a top-up when the balance drops
# under the user's line. Needs Polar's off-session charges switched on for the organization
# (a preview feature). Empty = false: hidden in the web app, nothing is charged.
AUTO_TOPUP_ENABLED=false

# Who pays for the AI: platform (default: Hermes on platform credits when the user brings nothing)
# or own_only (the user must add an API key or connect their Claude plan first)
AI_ACCESS_MODE=platform

# The crew's specialists that are switched on, comma-separated: byte, patch, scout (or none).
# They live in the agent image; this is what the apps show as available. Empty = all three.
CREW_AVAILABLE=byte,patch,scout

# Scout's browser (Max plan, 2 credits per minute). It runs inside the user's container, so it
# needs the agent image that has it. Set true only once that image is deployed: until then no
# container's browser is switched on and the apps show it as not available. Empty = false.
BROWSER_AVAILABLE=false

# Scout's web search through Textcrew (the web_search platform tool, Max plan only).
# Provider: brave (the only one built).
# Without BRAVE_SEARCH_API_KEY the tool tells the agent that search isn't set up; read_page still works.
# Key: https://api-dashboard.search.brave.com (the "Search" plan, $5 per 1,000 searches)
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
# The cost a search is charged for, in dollars; users pay it x 2.5 in credits.
# 0.004 x 2.5 = $0.01 = exactly 1 credit per search (the decided price). Brave's own price is
# $0.005 a search; 0.005 here would charge 1.25 credits (1, 1, 1, 2).
WEB_SEARCH_COST_USD=0.004

# Optional monthly cap on free credits (sign-up + coupons)
FREE_CREDITS_MONTHLY_CAP=

BACKUP_DIR=/var/backups/personal-agent
# Path inside the vm-manager's SNAPSHOT_ROOT (it writes the volume archives)
BACKUP_VOLUMES_DIR=/backups/volumes
# e.g. rclone copy {dir} b2crypt:personal-agent/{date}
BACKUP_UPLOAD_CMD=
# Days the dumps are kept; the privacy page says 7. Keep equal to the vm-manager's SNAPSHOT_KEEP_DAYS.
BACKUP_KEEP_DAYS=7
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
# Founder alerts on Telegram (sign-ups, server usage at every 10%, paying clients, errors).
# Comma list of Telegram chat ids. Empty: they go to the linked Telegram chat of every admin.
FOUNDER_TELEGRAM_CHAT_IDS=
# Mute one kind with false (all default on).
FOUNDER_ALERT_SIGNUPS=true
FOUNDER_ALERT_USAGE=true
FOUNDER_ALERT_PAYMENTS=true
FOUNDER_ALERT_ERRORS=true
# Keep equal to the vm-manager's AWAKE_CAP (only used to say "6/8 awake" in usage alerts).
AWAKE_CAP=20
# The deployed commit, shown on the admin health page. deploy.sh passes it on; leave it empty.
GIT_COMMIT=
RATE_LIMIT_PER_IP_PER_MIN=600
# Where chat files are kept (one folder per user). In Docker Compose this is set to
# /data/attachments, a named volume, whatever is here. Running on the host (pnpm dev) needs a
# folder you can write to.
ATTACHMENTS_DIR=.tmp/attachments
MEDIA_MAX_BYTES=26214400
TRUST_PROXY=false
