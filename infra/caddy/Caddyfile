{
	admin 127.0.0.1:2019
}

{$API_DOMAIN} {
	encode gzip

	# /mcp (the Platform MCP, and attachment downloads under /mcp/files/) and /git (the git
	# gateway) are for user containers only. Containers reach the api directly on the private
	# network through the egress proxy, never through Caddy, so both are closed to the internet
	# (docs/mvp-hld.md section 4).
	@containers_only path /mcp* /git /git/*
	handle @containers_only {
		respond "Not found" 404
	}

	handle {
		reverse_proxy {$API_UPSTREAM} {
			flush_interval -1
		}
	}
}

# The web app (the `web` service). Pages call their own /api/v1/*, which the web app forwards to
# the api on the private network.
{$WEB_DOMAIN} {
	encode gzip
	reverse_proxy {$WEB_UPSTREAM} {
		flush_interval -1
	}
}
